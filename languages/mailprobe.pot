#. Plugin Name of the plugin
#: mailprobe.php
#: includes/class-mailprobe-admin.php:183
msgid "MailProbe"
msgstr ""

#. Plugin URI of the plugin
#: mailprobe.php
msgid "https://mailprobe.dev/"
msgstr ""

#. Description of the plugin
#: mailprobe.php
msgid "Refuses registrations with an email address that cannot receive emails or is disposable, and flags WooCommerce orders whose billing email has the same problem. Checks by MailProbe, hosted in the EU (France)."
msgstr ""

#. Author of the plugin
#: mailprobe.php
msgid "Iris Digital"
msgstr ""

#. Author URI of the plugin
#: mailprobe.php
msgid "https://irisdigital.tech/"
msgstr ""

#. translators: %s: URL of the MailProbe privacy policy.
#: includes/class-mailprobe-admin.php:69
#, php-format
msgid "When a visitor creates an account or places an order, this site sends the email address entered to MailProbe (mailprobe.dev), a service of Iris Digital hosted in France, to check that the address can receive emails. MailProbe checks the address in real time and does not store it once the check is done. MailProbe privacy policy: %s"
msgstr ""

