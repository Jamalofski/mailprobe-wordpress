msgstr "MailProbe demande de ralentir (limite de débit)."

#. translators: %d: HTTP status code.
#: includes/class-mailprobe-client.php:187
#, php-format
msgid "MailProbe had a server error (HTTP %d)."
msgstr "MailProbe a rencontré une erreur serveur (HTTP %d)."

#. translators: 1: HTTP status code, 2: message from the API.
#: includes/class-mailprobe-client.php:190
#, php-format
